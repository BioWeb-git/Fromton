<article class="layout_gallery_fondus news-item <?= $this->class ?> is-animated">
    <?php if ($this->text): ?>
        <?= $this->text ?>
    <?php else: ?>
        <?php
            $contentElements = \Contao\ContentModel::findPublishedByPidAndTable($this->id, 'tl_news');
            if ($contentElements) {
                foreach ($contentElements as $content) {
                    echo \Contao\Controller::getContentElement($content->id);
                }
            }
        ?>
    <?php endif; ?>
</article>
